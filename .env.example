# Puerto del servidor local
PUERTO=4400
# Tope de gasto del investigador por día, en USD
TOPE_USD_DIA=2
# Horas del barrido automático (cron de 5 campos, hora local). Vacío = solo manual.
CRON_BARRIDO=0 7,19 * * *
# Si se define, el Agent SDK usa esta llave en vez de la sesión de Claude Code del Mac
# ANTHROPIC_API_KEY=
# Modelos (por defecto claude-opus-5-5 en ambos). Para abaratar el barrido: MODELO_INVESTIGADOR=claude-sonnet-5-5
# MODELO_INVESTIGADOR=
# MODELO_CHAT=
