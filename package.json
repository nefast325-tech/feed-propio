{
  "name": "feed-propio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Feed de información curada por criterios propios, con un agente investigador y un chat. Todo en localhost.",
  "scripts": {
    "dev": "concurrently -k -n servidor,web -c blue,green \"npm run dev:servidor\" \"npm run dev:web\"",
    "dev:servidor": "node --watch --use-system-ca --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --use-system-ca --env-file-if-exists=.env server/index.ts",
    "buscar": "node --use-system-ca --env-file-if-exists=.env server/cli.ts buscar",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@hono/node-server": "^1.14.0",
    "croner": "^9.0.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tp3/chat-widget": "github:nefast325-tech/chat-widget#60090dc5861d6f0c45fd7600061f6090634745a1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "engines": { "node": ">=24" }
}
